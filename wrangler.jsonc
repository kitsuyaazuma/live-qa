/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "live-qa",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"migrations": [
		{
			"new_sqlite_classes": ["Room"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Room",
				"name": "ROOM"
			}
		]
	},
	// No database_id, so this file works on any account: the first deploy creates
	// a database of this name and later ones find it by name. Locally the name is
	// the database's id as well, shared by vite dev and wrangler d1 --local.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "live-qa",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// Per client address and per colo. A hall behind one NAT is one address, so
	// these only bound what a script from one machine can do, not what a person can.
	"ratelimits": [
		{ "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 50, "period": 10 } },
		{ "name": "VOTE_LIMIT", "namespace_id": "1002", "simple": { "limit": 500, "period": 10 } }
	],
	"vars": {
		// Empty leaves questions untranslated.
		"TRANSLATION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		// "TRANSLATION_MODEL": "@cf/qwen/qwen3.8-27b",
		// BCP-47 codes. Empty source lets the model detect it.
		"TRANSLATION_TARGET_LANG": "en",
		"TRANSLATION_SOURCE_LANG": "",
		"TRANSLATION_CONTEXT": "",
		// Honoured only when the object is first created. Empty lets Cloudflare
		// place it at whichever colo reaches it first.
		"ROOM_LOCATION_HINT": ""
	},
	// The directory is filled in by the vite plugin at build time. A request that
	// matches no asset reaches the worker, which hands the deep link back here.
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
