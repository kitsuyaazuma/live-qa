# Copy to .dev.vars (gitignored) and fill in. Overrides wrangler.jsonc vars.

# BCP-47 codes, so a provider that wants codes needs no reverse lookup.
# Regional codes work too: en-GB, pt-BR.
TRANSLATION_TARGET_LANG="en"
TRANSLATION_SOURCE_LANG="ja"

# Free-form cues for the translator: the event, the speaker, terms to leave as
# they are, phrasing you prefer. Anything that helps; nothing is required.
TRANSLATION_CONTEXT="Event: Platform Engineering Kaigi 2026\nTalk: Architecting Agentic Development Platforms\nSpeaker: Kaspar von Grünberg, Author, Thinking in Platforms\nLeave these as written: Internal Developer Platform, IDP, platform orchestrator, Agentic Development Platform\nTranslate 基盤 as \"platform\", not \"foundation\""

# TRANSLATION_MODEL="@cf/qwen/qwen3.8-27b"

PRIVACY_OPERATOR=""
PRIVACY_CONTACT=""

# Signs the device and session cookies, so nothing can be asked or voted without it.
SESSION_SECRET="local-development-only"

# Signing in. Callbacks are <origin>/auth/google and <origin>/auth/github.
# One Google client can list both the deployed origin and
# http://localhost:5173; GitHub is sent back to an app's first callback URL,
# so register a separate GitHub app for local work with only the localhost
# callback. In production: wrangler secret put <NAME> for each of these.
ADMIN_EMAILS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare's testing pair passes everyone, on any host.
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
